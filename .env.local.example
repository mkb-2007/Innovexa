# FloatChat Environment Variables Example
# Copy this file to .env.local and add your keys if available.

# Optional: Google Maps Platform Photorealistic 3D Tiles API Key
# If not provided, FloatChat will gracefully fallback to standard Cesium ocean imagery.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: Cesium Ion Access Token (for Cesium Ion assets)
NEXT_PUBLIC_CESIUM_ION_TOKEN=
